/* ------------------------------------------------------------
 * HEXADECIMAL FLOATING CONSTANTS
 *
 * C hexadecimal floating constants require a binary exponent:
 * p or P followed by an optionally signed decimal exponent.
 * ------------------------------------------------------------ */

0x0p0
0x1p0
0x2p0
0xap0
0xFp0

0X0P0
0X1P0
0X2P0
0XAP0
0XFP0

0x1p1
0x1p2
0x1p3
0x1p4
0x1p8
0x1p10
0x1p16
0x1p32

0x1p-1
0x1p-2
0x1p-3
0x1p-8
0x1p-16

0x1p+1
0x1p+2
0x1p+3
0x1p+8
0x1p+16


/* ------------------------------------------------------------
 * HEXADECIMAL FLOATING FRACTIONS
 * ------------------------------------------------------------ */

0x0.0p0
0x1.0p0
0x1.1p0
0x1.2p0
0x1.8p0
0x1.ap0
0x1.fp0

0xA.Bp0
0xF.Fp0

0x1.0p1
0x1.0p2
0x1.0p-1
0x1.0p-2
0x1.0p+1
0x1.0p+2

0x1.8p1
0x1.8p2
0x1.8p-1
0x1.8p-2

0xAB.CDp10
0xAB.CDp-10
0xAB.CDp+10


/* ------------------------------------------------------------
 * HEX FLOATS WITH f/F/L SUFFIXES
 * ------------------------------------------------------------ */

0x1p0f
0x1p0F
0x1p0l
0x1p0L

0x1.0p0f
0x1.0p0F
0x1.0p0l
0x1.0p0L

0x1.8p10f
0x1.8p10F
0x1.8p10l
0x1.8p10L

0x1.8p-10f
0x1.8p-10F
0x1.8p-10l
0x1.8p-10L
